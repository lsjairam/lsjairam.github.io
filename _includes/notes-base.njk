<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f2eee5">
  <title>{{ seo.title or title }} — L. J. Llamas</title>
  <meta name="description" content="{{ seo.description or summary }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if isLive %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ seo.title or title }}">
  <meta property="og:description" content="{{ seo.description or summary }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="Engrllamas">
  {% if seo.image or cover_image %}<meta property="og:image" content="{{ site.url }}{{ seo.image or cover_image }}">{% endif %}
  <meta name="twitter:card" content="{% if seo.image or cover_image %}summary_large_image{% else %}summary{% endif %}">
  {% if isLive %}<meta property="article:published_time" content="{{ date | isoDate }}T00:00:00+08:00">
  <meta property="article:section" content="{{ category }}">
  <script type="application/ld+json">{{ {title: title, summary: summary, seo: seo, date: date, cover_image: cover_image, page: page} | articleSchema | safe }}</script>{% endif %}
  <link rel="preload" href="/assets/fonts/Archivo[wdth,wght].ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/css/archivo.css">
  <link rel="stylesheet" href="/css/portfolio.css?v=2">
  <link rel="stylesheet" href="/css/notes.css">
  <script>try{const t=localStorage.getItem('engrllamas-theme');if(t)document.documentElement.dataset.theme=t;else if(matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.dataset.theme='dark'}catch(_){}</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "notes-header.njk" %}
  <main class="page-main" id="main">{{ content | safe }}</main>
  {% include "notes-footer.njk" %}
  <script src="/js/portfolio.js?v=2" defer></script>
</body>
</html>

